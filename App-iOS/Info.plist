<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged by Xcode with the generated keys (GENERATE_INFOPLIST_FILE = YES). As on the Mac, sync
	     servers can be reached over plain http on Tailscale/LAN addresses. -->
	<!-- One window: every session lives in one SessionManager, so a second window would show the
	     same tabs twice. -->
	<!-- Launch screen: the app logo on the navy background, the same as the first SwiftUI screen
	     (SplashView), so the app opens straight onto it instead of a black screen. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>AppLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- "Open in SwiftSSH" for private key files exported from 1Password: .key and .pem files, and
	     (as an alternate handler) any file, because exported keys often have no extension
	     ("id_ed25519"). iOS hands the app a copy, which it reads into the Keys import form and deletes. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>SSH Private Key</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.cwland.swiftssh.private-key</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Key File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.plain-text</string>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.cwland.swiftssh.private-key</string>
			<key>UTTypeDescription</key>
			<string>SSH Private Key</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>key</string>
					<string>pem</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- Export compliance: SSH uses only standard encryption (no proprietary algorithms), so App
	     Store Connect doesn't ask about it for every TestFlight build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
